
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Discover NXQHUB, THE BOSS and PANDA — intelligent business solutions designed to help owners stay in control.">
  <title>NXQ Products | NXQ</title>
  <link rel="stylesheet" href="styles.css">

  <style>
    .products-hero {
      padding: 110px 8%;
      background:
        radial-gradient(ellipse at 80% 40%, rgba(75,156,255,.17), transparent 55%),
        linear-gradient(120deg,#080d16,#0b1422);
    }

    .products-hero h1 {
      font-size: clamp(44px,6vw,76px);
      line-height: 1.08;
      letter-spacing: -3px;
      margin: 28px 0;
      max-width: 850px;
    }

    .products-hero p {
      color: var(--muted);
      font-size: 18px;
      max-width: 680px;
      line-height: 1.9;
    }

    .brand-promise {
      padding: 30px 8%;
      background: #101a29;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      text-align: center;
      letter-spacing: 2px;
      font-size: 13px;
      font-weight: 700;
    }

    .brand-promise span {
      color: var(--accent-light);
    }

    .product-section {
      padding: 95px 8%;
      background: var(--bg);
    }

    .product-section.alt {
      background: #0b111c;
    }

    .product-heading {
      max-width: 760px;
      margin-bottom: 45px;
    }

    .product-heading h2 {
      font-size: clamp(34px,4.5vw,55px);
      line-height: 1.15;
      margin: 20px 0;
      letter-spacing: -2px;
    }

    .product-heading p {
      color: var(--muted);
      font-size: 16px;
      line-height: 1.9;
    }

    .product-panel {
      border: 1px solid var(--border);
      background: var(--surface);
      padding: 45px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .product-panel h3 {
      font-size: 30px;
      margin: 12px 0;
    }

    .product-panel p {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.9;
      margin: 15px 0;
    }

    .product-label {
      color: var(--accent-light);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 3px;
    }

    .product-visual {
      min-height: 260px;
      display: flex;
      align-items: center;
      justify-content: center;
      background:
        radial-gradient(circle,rgba(75,156,255,.16),transparent 65%);
      border: 1px solid var(--border);
    }

    .hub-mark {
      font-size: 64px;
      font-weight: 800;
      letter-spacing: 5px;
    }

    .hub-mark span {
      color: var(--accent);
    }

    .boss-mark {
      font-size: 150px;
      line-height: 1;
      font-weight: 800;
      color: var(--accent-light);
      text-shadow: 0 0 55px rgba(75,156,255,.3);
    }

    .panda-mark {
      font-size: 90px;
      font-weight: 800;
      color: var(--accent-light);
      letter-spacing: 5px;
    }

    .product-features {
      list-style: none;
      margin: 25px 0;
    }

    .product-features li {
      color: #d8e0eb;
      font-size: 13px;
      padding: 10px 0;
      border-bottom: 1px solid var(--border);
    }

    .product-features li::before {
      content: "＋";
      color: var(--accent);
      margin-right: 12px;
    }

    .architecture {
      padding: 85px 8%;
      background: #101a29;
      text-align: center;
    }

    .architecture h2 {
      font-size: clamp(32px,4vw,48px);
      margin: 20px 0;
    }

    .architecture p {
      color: var(--muted);
      max-width: 680px;
      margin: 0 auto;
      line-height: 1.9;
    }

    .architecture-box {
      max-width: 650px;
      margin: 40px auto 0;
      padding: 30px;
      border: 1px solid var(--accent);
      background: rgba(75,156,255,.06);
    }

    .architecture-box strong {
      display: block;
      font-size: 22px;
      letter-spacing: 2px;
    }

    .architecture-box small {
      display: block;
      color: var(--muted);
      margin-top: 8px;
    }

    .architecture-boss {
      margin-top: 22px;
      padding: 20px;
      border: 1px solid var(--border);
      background: var(--surface);
    }

    .architecture-boss b {
      font-size: 24px;
      color: var(--accent-light);
    }

    @media(max-width:760px) {
      .products-hero {
        padding: 75px 7%;
      }

      .product-section {
        padding: 70px 7%;
      }

      .product-panel {
        grid-template-columns: 1fr;
        padding: 25px;
        gap: 25px;
      }

      .product-visual {
        min-height: 200px;
      }

      .brand-promise {
        line-height: 2;
        padding: 25px 7%;
      }
    }
  </style>
</head>

